@model List<FootballManager.ViewModels.DrillListItem>
@using FootballManager.Models
@{
    ViewData["Title"] = "Thư viện bài tập";
    string? cat    = ViewBag.Category as string;
    string? search = ViewBag.Search   as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="page-title">
        <i class="bi bi-collection-play me-2 text-accent"></i>Thư viện bài tập
    </h4>
    @if (User.IsInRole("Admin") || User.IsInRole("Coach"))
    {
        <a asp-action="Create" class="btn btn-success btn-sm">
            <i class="bi bi-plus-lg me-1"></i>Thêm bài tập
        </a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* Bộ lọc *@
<div class="card mb-4">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Loại bài tập</label>
                <div class="btn-group w-100" role="group">
                    <a href="?search=@search" class="btn btn-sm @(cat == null ? "btn-success" : "btn-outline-secondary")">
                        Tất cả
                    </a>
                    <a href="?category=Physical&search=@search"
                       class="btn btn-sm @(cat == "Physical" ? "btn-danger" : "btn-outline-secondary")">
                        💪 Thể lực
                    </a>
                    <a href="?category=Technical&search=@search"
                       class="btn btn-sm @(cat == "Technical" ? "btn-primary" : "btn-outline-secondary")">
                        ⚽ Kỹ thuật
                    </a>
                    <a href="?category=Tactical&search=@search"
                       class="btn btn-sm @(cat == "Tactical" ? "btn-warning" : "btn-outline-secondary")">
                        🧠 Chiến thuật
                    </a>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">Tìm kiếm</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input name="search" value="@search" class="form-control"
                           placeholder="Tên bài tập..." />
                    @if (!string.IsNullOrEmpty(cat))
                    {
                        <input type="hidden" name="category" value="@cat" />
                    }
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-info w-100">
                    <i class="bi bi-search me-1"></i>Tìm
                </button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card text-center py-5">
        <div class="card-body">
            <i class="bi bi-inbox fs-1 d-block mb-3" style="opacity:0.2;color:var(--fm-accent)"></i>
            <p class="text-muted">Chưa có bài tập nào. Hãy tạo bài tập đầu tiên!</p>
        </div>
    </div>
}
else
{
    foreach (var group in Model.GroupBy(d => d.Category).OrderBy(g => g.Key))
    {
        string accentColor = group.Key switch
        {
            TrainingCategory.Physical  => "var(--fm-danger)",
            TrainingCategory.Technical => "var(--fm-info)",
            TrainingCategory.Tactical  => "var(--fm-gold)",
            _ => "var(--fm-accent)"
        };
        string icon = group.Key switch
        {
            TrainingCategory.Physical  => "bi-heart-pulse",
            TrainingCategory.Technical => "bi-dribbble",
            TrainingCategory.Tactical  => "bi-diagram-3",
            _ => "bi-collection"
        };

        <div class="mb-5">
            <div class="d-flex align-items-center gap-2 mb-3">
                <div style="width:4px;height:24px;background:@accentColor;border-radius:2px"></div>
                <i class="bi @icon" style="color:@accentColor;font-size:1.1rem"></i>
                <span class="fw-bold" style="color:@accentColor">@group.First().CategoryLabel</span>
                <span class="text-muted small">— @group.Count() bài</span>
            </div>

            <div class="row g-3">
                @foreach (var drill in group)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100" style="border-left:3px solid @accentColor">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h6 class="fw-semibold mb-0">@drill.Name</h6>
                                    @if (drill.IsShared)
                                    {
                                        <span class="badge" style="background:rgba(77,166,255,0.15);color:var(--fm-info);font-size:0.65rem">
                                            <i class="bi bi-share me-1"></i>Chia sẻ
                                        </span>
                                    }
                                </div>

                                <div class="d-flex gap-3 small text-muted mb-3">
                                    @if (drill.DurationMinutes.HasValue)
                                    {
                                        <span><i class="bi bi-clock me-1"></i>@drill.DurationMinutes'</span>
                                    }
                                    <span title="Độ khó">@drill.DifficultyLabel</span>
                                    @if (drill.UsageCount > 0)
                                    {
                                        <span style="color:@accentColor">
                                            <i class="bi bi-repeat me-1"></i>@drill.UsageCount lần
                                        </span>
                                    }
                                </div>

                                <div class="d-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@drill.Id"
                                       class="btn btn-xs btn-outline-secondary flex-grow-1">
                                        <i class="bi bi-eye me-1"></i>Xem
                                    </a>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Coach"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@drill.Id"
                                           class="btn btn-xs btn-outline-warning px-2">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}
