@model FootballManager.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - Football Manager</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        body {
            background: radial-gradient(ellipse at 20% 50%, #0d2040 0%, #0f1117 60%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', sans-serif;
        }
        .login-wrap {
            width: 100%;
            max-width: 420px;
            padding: 1rem;
        }
        .login-card {
            background: #1a1d2e;
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: 20px;
            box-shadow: 0 24px 64px rgba(0,0,0,0.6);
            overflow: hidden;
        }
        .login-header {
            background: linear-gradient(135deg, #0d2040, #1a1d2e);
            padding: 2.5rem 2rem 2rem;
            text-align: center;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            position: relative;
        }
        .login-header::before {
            content: '';
            position: absolute;
            width: 200px; height: 200px;
            background: radial-gradient(circle, rgba(0,212,170,0.12), transparent);
            top: -60px; left: 50%;
            transform: translateX(-50%);
            border-radius: 50%;
        }
        .login-icon {
            width: 68px; height: 68px;
            background: rgba(0,212,170,0.12);
            border: 2px solid rgba(0,212,170,0.3);
            border-radius: 18px;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 1rem;
            font-size: 1.8rem;
            color: #00d4aa;
            position: relative;
        }
        .login-header h4 {
            font-weight: 700;
            font-size: 1.4rem;
            color: #e8eaed;
            margin-bottom: 0.25rem;
        }
        .login-header small {
            color: #8b92a5;
            font-size: 0.82rem;
        }
        .login-body {
            padding: 2rem;
        }
        .login-body .form-label {
            color: #8b92a5;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .login-body .form-control {
            background: #222640;
            border: 1px solid rgba(255,255,255,0.07);
            color: #e8eaed;
            border-radius: 8px;
            padding: 0.65rem 0.9rem;
            font-size: 0.9rem;
        }
        .login-body .form-control:focus {
            border-color: #00d4aa;
            box-shadow: 0 0 0 3px rgba(0,212,170,0.15);
            background: #222640;
        }
        .login-body .form-control::placeholder { color: #4a5070; }
        .login-body .input-group-text {
            background: #222640;
            border: 1px solid rgba(255,255,255,0.07);
            color: #8b92a5;
            border-radius: 8px 0 0 8px;
        }
        .login-body .input-group .form-control {
            border-radius: 0 8px 8px 0;
            border-left: none;
        }
        .btn-login {
            background: #00d4aa;
            border: none;
            color: #0f1117;
            font-weight: 700;
            font-size: 0.95rem;
            padding: 0.75rem;
            border-radius: 10px;
            width: 100%;
            transition: all 0.2s;
            letter-spacing: 0.3px;
        }
        .btn-login:hover {
            background: #00bfa0;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(0,212,170,0.35);
            color: #0f1117;
        }
        .divider-text {
            color: #3a3d5c;
            font-size: 0.75rem;
            text-align: center;
            margin: 1rem 0;
        }
        .alert-danger {
            background: rgba(255,77,109,0.1);
            border-color: rgba(255,77,109,0.3);
            color: #ff8099;
            border-radius: 8px;
            font-size: 0.85rem;
        }
        .form-check-input:checked {
            background-color: #00d4aa;
            border-color: #00d4aa;
        }
        .form-check-label { color: #8b92a5; font-size: 0.85rem; }
    </style>
</head>
<body>
    <div class="login-wrap">
        <div class="login-card">
            <div class="login-header">
                <div class="login-icon">
                    <i class="bi bi-trophy-fill"></i>
                </div>
                <h4>Football Manager</h4>
                <small>Hệ thống quản lý đội bóng</small>
            </div>
            <div class="login-body">
                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                    <div asp-validation-summary="All" class="alert alert-danger py-2 mb-3"
                         style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label">Tên đăng nhập</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input asp-for="Username" class="form-control" placeholder="Nhập tên đăng nhập" autofocus />
                        </div>
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Mật khẩu</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 d-flex align-items-center justify-content-between">
                        <div class="form-check mb-0">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label>
                        </div>
                    </div>

                    <button type="submit" class="btn-login">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập
                    </button>
                </form>

                <div class="divider-text mt-4">
                    <i class="bi bi-shield-lock me-1"></i>
                    Hệ thống bảo mật — chỉ dành cho thành viên được cấp quyền
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
