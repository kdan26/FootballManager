@model IEnumerable<FootballManager.ViewModels.PlayerListItemViewModel>
@using FootballManager.Models
@{
    ViewData["Title"] = $"Cầu thủ - {ViewBag.TeamName}";
    int teamId = ViewBag.TeamId;

    string HealthBadge(PlayerHealthStatus s) => s switch
    {
        PlayerHealthStatus.Fit        => "bg-success",
        PlayerHealthStatus.Injured    => "bg-danger",
        PlayerHealthStatus.Sick       => "bg-warning",
        PlayerHealthStatus.Suspended  => "bg-secondary",
        PlayerHealthStatus.Recovering => "bg-info",
        _ => "bg-secondary"
    };
    string HealthLabel(PlayerHealthStatus s) => s switch
    {
        PlayerHealthStatus.Fit        => "Sẵn sàng",
        PlayerHealthStatus.Injured    => "Chấn thương",
        PlayerHealthStatus.Sick       => "Ốm đau",
        PlayerHealthStatus.Suspended  => "Treo giò",
        PlayerHealthStatus.Recovering => "Hồi phục",
        _ => ""
    };
    string PosBg(PlayerPosition p) => p switch
    {
        PlayerPosition.GoalKeeper                             => "#f5a623",
        PlayerPosition.CenterBack or PlayerPosition.FullBack  => "#00d4aa",
        PlayerPosition.DefensiveMid or PlayerPosition.CentralMid => "#4da6ff",
        _                                                      => "#ff4d6d"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-2">
        <a asp-controller="Team" asp-action="Details" asp-route-id="@teamId"
           class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h4 class="page-title mb-0">
                <i class="bi bi-person-badge me-2 text-accent"></i>@ViewBag.TeamName
            </h4>
            <span class="text-muted small">@Model.Count() cầu thủ</span>
        </div>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Coach"))
    {
        <a asp-action="Create" asp-route-teamId="@teamId" class="btn btn-success btn-sm">
            <i class="bi bi-person-plus me-1"></i>Thêm cầu thủ
        </a>
    }
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="card text-center py-5">
        <div class="card-body">
            <i class="bi bi-person-x fs-1 d-block mb-3" style="opacity:0.2;color:var(--fm-accent)"></i>
            <p class="text-muted">Chưa có cầu thủ nào trong đội</p>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var p in Model)
        {
            <div class="col-sm-6 col-lg-4 col-xl-3">
                <div class="card h-100 @(p.IsActive ? "" : "opacity-50")"
                     style="border-top: 3px solid @PosBg(p.Position)">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            @* Avatar — ảnh hoặc số áo *@
                            @if (!string.IsNullOrEmpty(p.PhotoUrl))
                            {
                                <img src="@p.PhotoUrl" alt="@p.FullName"
                                     class="rounded-circle"
                                     style="width:48px;height:48px;object-fit:cover;flex-shrink:0;border:2px solid @(PosBg(p.Position))66" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center rounded-circle fw-bold"
                                     style="width:48px;height:48px;font-size:1.2rem;flex-shrink:0;background:@PosBg(p.Position);color:#0f1117">
                                    @(p.JerseyNumber?.ToString() ?? "?")
                                </div>
                            }
                            <div class="flex-grow-1 min-w-0">
                                <div class="fw-semibold text-truncate">@p.FullName</div>
                                <div class="small text-muted">@p.PositionLabel</div>
                            </div>
                        </div>

                        @* Health status *@
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="badge @HealthBadge(p.HealthStatus)" style="font-size:0.68rem">
                                @HealthLabel(p.HealthStatus)
                            </span>
                            @if (!p.IsActive)
                            {
                                <span class="badge bg-secondary" style="font-size:0.68rem">Không HĐ</span>
                            }
                        </div>

                        @* Actions *@
                        <div class="d-flex gap-1">
                            <a asp-action="Details" asp-route-id="@p.Id"
                               class="btn btn-xs btn-outline-info flex-grow-1">
                                <i class="bi bi-eye me-1"></i>Chi tiết
                            </a>
                            <a asp-controller="PlayerStats" asp-action="Index" asp-route-playerId="@p.Id"
                               class="btn btn-xs btn-outline-secondary px-2" title="Chỉ số">
                                <i class="bi bi-graph-up"></i>
                            </a>
                            @if (User.IsInRole("Admin") || User.IsInRole("Coach"))
                            {
                                <a asp-action="Edit" asp-route-id="@p.Id"
                                   class="btn btn-xs btn-outline-warning px-2" title="Sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@p.Id" method="post"
                                      onsubmit="return confirm('Xóa cầu thủ @p.FullName?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-xs btn-outline-danger px-2" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
