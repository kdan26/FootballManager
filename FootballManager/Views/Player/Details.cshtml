@model FootballManager.ViewModels.PlayerDetailsViewModel
@using FootballManager.Models
@{
    ViewData["Title"] = Model.FullName;

    string healthBadge = Model.HealthStatus switch
    {
        PlayerHealthStatus.Fit        => "bg-success",
        PlayerHealthStatus.Injured    => "bg-danger",
        PlayerHealthStatus.Sick       => "bg-warning",
        PlayerHealthStatus.Suspended  => "bg-secondary",
        PlayerHealthStatus.Recovering => "bg-info",
        _ => "bg-secondary"
    };
    string healthLabel = Model.HealthStatus switch
    {
        PlayerHealthStatus.Fit        => "Sẵn sàng thi đấu",
        PlayerHealthStatus.Injured    => "Chấn thương",
        PlayerHealthStatus.Sick       => "Ốm đau",
        PlayerHealthStatus.Suspended  => "Treo giò",
        PlayerHealthStatus.Recovering => "Đang hồi phục",
        _ => ""
    };
    string posColor = Model.Position switch
    {
        PlayerPosition.GoalKeeper                             => "#f5a623",
        PlayerPosition.CenterBack or PlayerPosition.FullBack  => "#00d4aa",
        PlayerPosition.DefensiveMid or PlayerPosition.CentralMid => "#4da6ff",
        _                                                      => "#ff4d6d"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" asp-route-teamId="@Model.TeamId"
           class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h4 class="page-title mb-0">@Model.FullName</h4>
    </div>
    <span class="badge @healthBadge fs-6">@healthLabel</span>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    @* Profile card *@
    <div class="col-lg-4">
        <div class="card text-center" style="border-top: 4px solid @posColor">
            <div class="card-body py-4">
                @* Avatar — ảnh thật hoặc fallback số áo *@
                @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                {
                    <img src="@Model.PhotoUrl?v=@DateTime.Now.Ticks" alt="@Model.FullName"
                         class="rounded-circle mx-auto d-block mb-3"
                         style="width:90px;height:90px;object-fit:cover;border:3px solid @(posColor)44" />
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center rounded-circle mx-auto mb-3 fw-bold"
                         style="width:90px;height:90px;font-size:2rem;background:@(posColor)22;color:@posColor;border:3px solid @(posColor)44">
                        @(Model.JerseyNumber?.ToString() ?? "?")
                    </div>
                }
                <h5 class="fw-bold mb-1">@Model.FullName</h5>
                <span class="badge mb-2" style="background:@(posColor)22;color:@posColor;border:1px solid @(posColor)44">
                    @Model.PositionLabel
                </span>
                <div class="text-muted small mb-3">
                    <i class="bi bi-shield-fill me-1 text-accent"></i>@Model.TeamName
                </div>

                @if (!Model.IsActive)
                {
                    <div class="alert alert-warning py-1 mb-3 small">
                        <i class="bi bi-pause-circle me-1"></i>Không hoạt động
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.HealthNote))
                {
                    <div class="alert alert-danger py-2 mb-3 small text-start">
                        <i class="bi bi-bandaid me-1"></i>@Model.HealthNote
                        @if (Model.ExpectedReturnDate.HasValue)
                        {
                            <div class="mt-1 text-muted">
                                Dự kiến trở lại: <strong>@Model.ExpectedReturnDate.Value.ToString("dd/MM/yyyy")</strong>
                            </div>
                        }
                    </div>
                }

                @* Buttons *@
                <div class="d-flex flex-column gap-2">
                    <a asp-controller="PlayerStats" asp-action="Index" asp-route-playerId="@Model.Id"
                       class="btn btn-outline-info btn-sm">
                        <i class="bi bi-graph-up me-1"></i>Biểu đồ phong độ
                    </a>
                    <a asp-controller="Stats" asp-action="Player" asp-route-id="@Model.Id"
                       class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-bar-chart me-1"></i>Thống kê sự kiện
                    </a>
                    @if (User.IsInRole("Admin") || User.IsInRole("Coach"))
                    {
                        <a asp-controller="PlayerStats" asp-action="TacticalBoard"
                           asp-route-teamId="@Model.TeamId"
                           class="btn btn-outline-success btn-sm">
                            <i class="bi bi-diagram-3 me-1"></i>Bảng chiến thuật
                        </a>
                    }
                </div>
            </div>
        </div>

        @if (User.IsInRole("Admin") || User.IsInRole("Coach"))
        {
            <div class="card mt-3">
                <div class="card-header"><i class="bi bi-gear me-2"></i>Quản lý</div>
                <div class="card-body d-flex flex-column gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id"
                       class="btn btn-outline-warning btn-sm">
                        <i class="bi bi-pencil me-1"></i>Chỉnh sửa thông tin
                    </a>
                    <a asp-controller="PlayerStats" asp-action="UpdateHealth"
                       asp-route-playerId="@Model.Id"
                       class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-heart-pulse me-1"></i>Cập nhật sức khỏe
                    </a>
                    @* Upload ảnh *@
                    <div class="border-top pt-2 mt-1">
                        <p class="text-muted small mb-2">
                            <i class="bi bi-image me-1"></i>Ảnh đại diện
                        </p>
                        <form asp-action="UploadPhoto" asp-route-id="@Model.Id"
                              method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <div class="input-group input-group-sm">
                                <input type="file" name="photo" class="form-control form-control-sm"
                                       accept=".jpg,.jpeg,.png,.webp"
                                       style="font-size:0.75rem" />
                                <button type="submit" class="btn btn-outline-info btn-sm">
                                    <i class="bi bi-upload"></i>
                                </button>
                            </div>
                            <div class="text-muted mt-1" style="font-size:0.7rem">
                                JPG, PNG, WEBP — tối đa 2MB
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    @* Thông tin chi tiết *@
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-person-lines-fill me-2 text-accent"></i>Thông tin cầu thủ
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6">
                        <div class="text-muted small text-uppercase fw-semibold mb-1" style="letter-spacing:0.4px">Số áo</div>
                        <div class="fw-bold fs-5" style="color:@posColor">
                            #@(Model.JerseyNumber?.ToString() ?? "—")
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted small text-uppercase fw-semibold mb-1" style="letter-spacing:0.4px">Vị trí</div>
                        <div class="fw-semibold">@Model.PositionLabel</div>
                    </div>
                    @if (Model.DateOfBirth.HasValue)
                    {
                        <div class="col-6">
                            <div class="text-muted small text-uppercase fw-semibold mb-1" style="letter-spacing:0.4px">Ngày sinh</div>
                            <div>@Model.DateOfBirth.Value.ToString("dd/MM/yyyy")
                                @if (Model.Age.HasValue)
                                {
                                    <span class="text-muted small ms-1">(@Model.Age tuổi)</span>
                                }
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Nationality))
                    {
                        <div class="col-6">
                            <div class="text-muted small text-uppercase fw-semibold mb-1" style="letter-spacing:0.4px">Quốc tịch</div>
                            <div>@Model.Nationality</div>
                        </div>
                    }
                    <div class="col-6">
                        <div class="text-muted small text-uppercase fw-semibold mb-1" style="letter-spacing:0.4px">Đội bóng</div>
                        <a asp-controller="Team" asp-action="Details" asp-route-id="@Model.TeamId"
                           class="text-accent text-decoration-none fw-semibold">
                            <i class="bi bi-shield-fill me-1"></i>@Model.TeamName
                        </a>
                    </div>
                    <div class="col-6">
                        <div class="text-muted small text-uppercase fw-semibold mb-1" style="letter-spacing:0.4px">Trạng thái</div>
                        <span class="badge @healthBadge">@healthLabel</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="col-12">
                            <div class="text-muted small text-uppercase fw-semibold mb-1" style="letter-spacing:0.4px">Ghi chú</div>
                            <div class="p-2 rounded small" style="background:var(--fm-bg-3)">@Model.Notes</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
