@model FootballManager.ViewModels.DashboardViewModel
@using FootballManager.Models
@{
    ViewData["Title"] = "Tổng quan";
}

@* ── Header ── *@
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="page-title mb-1">
            <i class="bi bi-speedometer2 me-2 text-accent"></i>Tổng quan
        </h4>
        <p class="text-muted small mb-0">Chào mừng trở lại — @DateTime.Now.ToString("dddd, dd/MM/yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        @if (User.IsInRole("Admin") || User.IsInRole("Coach"))
        {
            <a asp-controller="Match" asp-action="Create" class="btn btn-success btn-sm">
                <i class="bi bi-plus-lg me-1"></i>Tạo trận mới
            </a>
        }
    </div>
</div>

@* ── Stat Cards ── *@
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat-card accent">
            <div class="stat-icon">
                <i class="bi bi-people-fill"></i>
            </div>
            <div class="stat-value">@Model.TotalTeams</div>
            <div class="stat-label">Đội bóng</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card info">
            <div class="stat-icon">
                <i class="bi bi-calendar-event-fill"></i>
            </div>
            <div class="stat-value">@Model.TotalMatches</div>
            <div class="stat-label">Tổng số trận</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card gold">
            <div class="stat-icon">
                <i class="bi bi-trophy-fill"></i>
            </div>
            <div class="stat-value">@Model.CompletedMatches</div>
            <div class="stat-label">Đã kết thúc</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card danger">
            <div class="stat-icon">
                <i class="bi bi-clock-fill"></i>
            </div>
            <div class="stat-value">@Model.UpcomingMatchCount</div>
            <div class="stat-label">Sắp diễn ra</div>
        </div>
    </div>
</div>

@* ── Trận đấu sắp diễn ra ── *@
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>
            <i class="bi bi-calendar-week me-2 text-accent"></i>
            Trận đấu sắp diễn ra
        </span>
        <a asp-controller="Match" asp-action="Index"
           class="btn btn-xs btn-outline-secondary">Xem tất cả</a>
    </div>
    <div class="card-body p-0">
        @if (!Model.UpcomingMatches.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-check fs-1 text-muted d-block mb-2" style="opacity:0.3"></i>
                <p class="text-muted mb-0">Không có trận đấu nào sắp diễn ra</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Đội nhà</th>
                            <th class="text-center px-0" style="width:40px">vs</th>
                            <th>Đội khách</th>
                            <th><i class="bi bi-clock me-1"></i>Thời gian</th>
                            <th><i class="bi bi-geo-alt me-1"></i>Địa điểm</th>
                            <th style="width:60px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.UpcomingMatches)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold">@m.HomeTeamName</span>
                                </td>
                                <td class="text-center px-0">
                                    <span class="badge bg-secondary" style="font-size:0.65rem">VS</span>
                                </td>
                                <td>
                                    <span class="fw-semibold">@m.AwayTeamName</span>
                                </td>
                                <td class="small">
                                    <div class="text-accent fw-semibold">@m.MatchDate.ToString("HH:mm")</div>
                                    <div class="text-muted">@m.MatchDate.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td class="small text-muted">@(m.Venue ?? "—")</td>
                                <td>
                                    <a asp-controller="Match" asp-action="Details" asp-route-id="@m.Id"
                                       class="btn btn-xs btn-outline-info py-0 px-2">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* ── Quick Links ── *@
<div class="row g-3 mt-3">
    <div class="col-12">
        <p class="text-muted small mb-2 fw-semibold text-uppercase" style="letter-spacing:0.5px">
            Truy cập nhanh
        </p>
    </div>
    <div class="col-6 col-md-3">
        <a asp-controller="Team" asp-action="Index"
           class="card text-decoration-none p-3 d-flex flex-row align-items-center gap-3"
           style="transition:all 0.2s">
            <div class="rounded-circle d-flex align-items-center justify-content-center"
                 style="width:40px;height:40px;background:var(--fm-accent-dim);flex-shrink:0">
                <i class="bi bi-people-fill text-accent"></i>
            </div>
            <div>
                <div class="fw-semibold small">Đội bóng</div>
                <div class="text-muted" style="font-size:0.72rem">Quản lý đội</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-controller="Calendar" asp-action="Index"
           class="card text-decoration-none p-3 d-flex flex-row align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center"
                 style="width:40px;height:40px;background:rgba(77,166,255,0.15);flex-shrink:0">
                <i class="bi bi-calendar3" style="color:var(--fm-info)"></i>
            </div>
            <div>
                <div class="fw-semibold small">Lịch thi đấu</div>
                <div class="text-muted" style="font-size:0.72rem">Xem lịch</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-controller="Stats" asp-action="Index"
           class="card text-decoration-none p-3 d-flex flex-row align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center"
                 style="width:40px;height:40px;background:var(--fm-gold-dim);flex-shrink:0">
                <i class="bi bi-bar-chart-fill" style="color:var(--fm-gold)"></i>
            </div>
            <div>
                <div class="fw-semibold small">Thống kê</div>
                <div class="text-muted" style="font-size:0.72rem">Top scorer</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-controller="Drill" asp-action="Index"
           class="card text-decoration-none p-3 d-flex flex-row align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center"
                 style="width:40px;height:40px;background:rgba(255,77,109,0.15);flex-shrink:0">
                <i class="bi bi-collection-play" style="color:var(--fm-danger)"></i>
            </div>
            <div>
                <div class="fw-semibold small">Thư viện bài tập</div>
                <div class="text-muted" style="font-size:0.72rem">Drill library</div>
            </div>
        </a>
    </div>
</div>
