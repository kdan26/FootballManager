@model IEnumerable<FootballManager.ViewModels.TeamListItemViewModel>
@{
    ViewData["Title"] = "Đội bóng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="page-title">
        <i class="bi bi-shield-fill me-2 text-accent"></i>Đội bóng
    </h4>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-success btn-sm">
            <i class="bi bi-plus-lg me-1"></i>Thêm đội mới
        </a>
    }
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="card text-center py-5">
        <div class="card-body">
            <i class="bi bi-people fs-1 d-block mb-3" style="opacity:0.2;color:var(--fm-accent)"></i>
            <p class="text-muted mb-3">Chưa có đội bóng nào</p>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-success btn-sm">
                    <i class="bi bi-plus-lg me-1"></i>Tạo đội đầu tiên
                </a>
            }
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var team in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100" style="border-left: 3px solid var(--fm-accent)">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="d-flex align-items-center justify-content-center rounded-circle fw-bold"
                                     style="width:44px;height:44px;background:var(--fm-accent-dim);color:var(--fm-accent);font-size:1.1rem;flex-shrink:0">
                                    <i class="bi bi-shield-fill"></i>
                                </div>
                                <div>
                                    <div class="fw-bold">@team.Name</div>
                                    <div class="text-muted small">
                                        <i class="bi bi-geo-alt me-1"></i>@(team.HomeGround ?? "Chưa có sân")
                                    </div>
                                </div>
                            </div>
                            <span class="badge bg-secondary">@team.MatchCount trận</span>
                        </div>
                        <div class="d-flex gap-2 mt-auto">
                            <a asp-action="Details" asp-route-id="@team.Id"
                               class="btn btn-outline-info btn-sm flex-grow-1">
                                <i class="bi bi-eye me-1"></i>Chi tiết
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@team.Id"
                                   class="btn btn-outline-warning btn-sm px-2">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@team.Id" method="post"
                                      onsubmit="return confirm('Xóa đội \'@team.Name\'?\n\nSẽ xóa toàn bộ cầu thủ, trận đấu và dữ liệu liên quan. Không thể hoàn tác!')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm px-2">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
